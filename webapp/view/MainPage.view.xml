<mvc:View
    controllerName="employeedatamaster.controller.MainPage"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:u="sap.ui.unified"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    displayBlock="true"
    xmlns:f="sap.ui.layout.form"
>
<Page id="page" showHeader="false">
    <content>
        <VBox id="_IDGenVBox" class="sapUiLargeMarginTop vBox1" alignItems="Center" justifyContent="Center">
           <!-- 
                <Title id="_IDGenTitle" text="Data Validator"></Title> 
           -->
            <f:SimpleForm
                id="IDGenSimpleForm"
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanL="4"
                labelSpanM="4"
                emptySpanL="3"
                emptySpanM="3"
                columnsL="1"
                columnsM="1"
                width="600px">

                <Label id="_IDGenLabel4" text="Country" />
                <ComboBox id="countrySelect" selectedKey="{countryModel>/Country}" items="{ path: 'countryModel>/Countries'}" placeholder="Select Country" change=".onCountrySelect">
                    <core:Item id="_IDGenItem1" key="{countryModel>countryId}" text="{countryModel>countryName}" />
                </ComboBox>
                
                <Label id="_IDGenLabel" text="Template" />
                <RadioButtonGroup id="rbFileType" columns="1" selectedIndex="" select="onTemplateSelection">
                    <buttons>
                        <RadioButton id="EmployeeData" text="Employee Data Master" />
                        <RadioButton id="CsfData" text="Employee Country Specific Fields(CSF) Data" />
                        <RadioButton id="CompData" text="Employee Data Compensation" enabled="false"/>
                    </buttons>
                </RadioButtonGroup>

                <Label id="_IDGenLabel1" text="Record Count" />
                <Input id="employeeCount" placeholder="No.of Employees" type="Number" liveChange="onEmployeeCountChange" />

                <Label id="_IDGenLabel2" text="Cut-off Date" />
                <DatePicker 
                    id="cutoffDate" 
                    placeholder="Select date" 
                    displayFormat="dd-MM-yyyy" 
                    valueFormat="dd-MM-yyyy" 
                    change="onDateSelection" />

                    <Label id="_IDGenLabelNew" text="Legal Entity" />

                    <!-- Commented Legal Box Dropdown as per new requirement changes
                    <ComboBox
                        id="legalDropdown"
                        width="100%"
                        placeholder="Select from the list"
                        enabled="false"
                        showSecondaryValues="true"
                        filterSecondaryValues="true"
                        items="{
                            path: 'businessUnitModel>/items'
                        }"> 

                        <core:Item
                            id="_IDGenItem1"
                            key="{businessUnitModel>BusinessUnit}"
                            text="{businessUnitModel>BusinessUnit}" />

                    </ComboBox>

                    -->

                <Label id="_IDGenLabel3" text="Upload File" />
                <u:FileUploader
                    id="fileUploader"
                    placeholder="choose..."
                    name="myFileUpload"
                    change=".onFileUpload"
                    uploadComplete=".onUploadComplete"
                    fileType="xlsx,csv"
                    buttonText="Browse"
                    width="570px" />

                <HBox id="_IDGenHBox" justifyContent="Center" class="sapUiSmallMarginTop">
                <Button id="_IDGenButton1"
                    text="Validate"
                    type="Emphasized"
                    press="onValidate"
                    class="sapUiTinyMarginEnd"
                    enabled="false"/>
                <Button id="_IDGenButton2"
                    text="Clear"
                    type="Reject"
                    press="onClearPress"
                    class="sapUiTinyMarginEnd"/>
                <Button id="_IDGenButton3"
                    text="Get Error Log"
                    type="Success"
                    press="onPressOfErrorSet"
                    class="sapUiTinyMarginEnd"
                    visible="false"/>  
                <!--
                <Button id="_IDGenButton7"
                    text="Open Dialog"
                    type="Critical"
                    press="onOpenCard"
                    class="sapUiTinyMarginEnd"
                    visible="true"/>
                -->
                <Button id="_IDGenButton8"
                    text="Get Codified Data"
                    type="Accept"
                    press="onDownloadCodifiedData"
                    class="sapUiTinyMarginEnd"
                    visible="false"/>
            </HBox>
            </f:SimpleForm>
        </VBox>
    </content>
</Page>
</mvc:View>